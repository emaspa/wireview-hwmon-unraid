<script>
// The tile shows what /include/WireviewDashboard.php?tile=1 returns: rows
// already formatted and filtered by the settings saved under
// Settings > Utilities > WireView Pro II > Dashboard Tile. The response
// also carries the refresh interval, so a saved change applies on the
// next poll without reloading the dashboard.
var wireviewDashTimer = null;

function wireviewDashSchedule(seconds) {
  if (wireviewDashTimer) clearTimeout(wireviewDashTimer);
  wireviewDashTimer = setTimeout(wireviewDashUpdate, seconds * 1000);
}

function wireviewDashUpdate() {
  $.getJSON('/plugins/wireview-hwmon/include/WireviewDashboard.php?tile=1', function(d) {
    var $tile = $('#wireview-dash-tile');
    $tile.find('tr.wv-data,tr.wv-hdr').remove();
    $('#wv-dash-title').text(d.title);
    $('#wv-dash-headline').html('<i class="fa fa-circle orb ' + d.color + '-orb middle"></i> ' + d.headline);

    var rows = '';
    $.each(d.sections, function(i, section) {
      rows += '<tr class="wv-hdr"><td style="height:8px"></td></tr>';
      rows += '<tr class="wv-hdr"><td><span class="w18"></span><span class="w72">' + section.title + '</span></td></tr>';
      $.each(section.rows, function(j, r) {
        rows += '<tr class="wv-data"><td>';
        rows += '<span class="w18"><i class="fa fa-circle orb ' + r.color + '-orb middle"></i></span>';
        rows += '<span class="w36">' + r.label + '</span>';
        rows += '<span class="w36">' + r.value + '</span>';
        rows += '</td></tr>';
      });
    });
    $tile.append(rows);
    wireviewDashSchedule(d.refresh || 2);
  }).fail(function() {
    $('#wv-dash-headline').html('<i class="fa fa-circle orb grey-orb middle"></i> Offline');
    wireviewDashSchedule(5);
  });
}
wireviewDashUpdate();
</script>
